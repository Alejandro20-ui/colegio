RewriteEngine On

# ========================================
# 1️⃣ REDIRECCIÓN LIMPIA DEL INDEX
# ========================================
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# ========================================
# 2️⃣ OCULTAR ACCESO DIRECTO A /php/
# (SOLO SI LO PIDEN DESDE EL NAVEGADOR)
# ========================================
RewriteCond %{THE_REQUEST} \s/php/ [NC]
RewriteRule ^php/ - [F,L]

# ========================================
# 3️⃣ HOME LIMPIA (INTERNA - SIN MOSTRAR EN URL)
# ========================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ php/principal.php [L]

# ========================================
# 4️⃣ URLs AMIGABLES PARA HTML
# ========================================
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-zA-Z0-9_-]+)$ $1.html [L]

# ========================================
# 5️⃣ SEGURIDAD EXTRA
# ========================================
Options -Indexes

<FilesMatch "(conexion|config_db)\.php">
    Require all denied
</FilesMatch>
